# Copia este archivo como .env.local (en local) y define las mismas
# variables en Vercel → tu proyecto → Settings → Environment Variables.
# .env.local NUNCA se sube a git (ya está en .gitignore).

# --- Base de datos (Neon → Connection Details) ---
# URL con pooler (la usa la web en Vercel)
DATABASE_URL=
# URL directa, sin pooler (la usan los scripts: neon:schema, neon:importar, fotos:*)
DIRECT_DATABASE_URL=

# --- Imágenes (Cloudinary → Dashboard → API Keys) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Panel /admin ---
# Contraseña para entrar a /admin. Cámbiala por una tuya.
ADMIN_PASSWORD=
# Cadena aleatoria larga (30+ caracteres) usada para firmar la cookie
# de sesión del panel. Genera una, por ejemplo, con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Reseñas (Google + Cloudflare Turnstile) ---
# Google Cloud → Credenciales → ID de cliente de OAuth (aplicación web)
GOOGLE_CLIENT_ID=
# Cloudflare Turnstile: clave pública (site key) y clave secreta
TURNSTILE_SITE_KEY=
TURNSTILE_KEY=

# --- Inventario: integración con facturación (opcional) ---
# Secreto compartido para firmar los eventos del sistema de facturación. Debe ser el MISMO que se
# configura en su integración. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVENTARIO_WEBHOOK_SECRET=

# Libro de Reclamaciones: correo (Resend, https://resend.com). Sin estas variables el reclamo se guarda
# igual, pero no se envía la copia al consumidor ni el aviso a la empresa.
RESEND_API_KEY=
RECLAMOS_EMAIL_FROM="Le Chic <reclamos@tudominio.pe>"
# Aviso de reclamos nuevos si no hay correo en /admin/configuracion → General
RECLAMOS_EMAIL_TO=
